# 1. Function that returns duplicate elements.
def find_duplicates(lst):
    seen = set()
    duplicates = set()

    for item in lst:
        if item in seen:
            duplicates.add(item)
        else:
            seen.add(item)

    return duplicates


duplicate_result = find_duplicates(
    [1, 2, 2, 3, 3, 3, 4]
)

print("\n7. Duplicates:", duplicate_result)


