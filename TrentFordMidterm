class Door:
    def __init__(self, name):
        self.name = name
        self.authorized_cards = set()

    def grant(self, card_id):
        self.authorized_cards.add(card_id)

    def revoke(self, card_id):
        self.authorized_cards.discard(card_id)

    def can_open(self, card_id):
        return card_id in self.authorized_cards


def master_cards(doors):
    if not doors:
        return set()
    common_cards = set(doors[0].authorized_cards)
    for door in doors[1:]:
        common_cards.intersection_update(door.authorized_cards)
    return common_cards


def single_door_cards(doors):
    card_counts = {}
    for door in doors:
        for card_id in door.authorized_cards:
            card_counts[card_id] = card_counts.get(card_id, 0) + 1
    return {
        card_id for card_id, count in card_counts.items()
        if count == 1
    }


def unused_cards(all_cards, doors):
    used_cards = set()
    for door in doors:
        used_cards.update(door.authorized_cards)
    return set(all_cards) - used_cards


def audit(doors):
    for door in doors:
        print(f"{door.name}: {len(door.authorized_cards)} cards")
    print(f"Master cards: {master_cards(doors)}")

