class Polynomial:
    def __init__(self, coeffs):
        self.coeffs = list(coeffs)  # store a copy

    def __str__(self):
        terms = []
        for i in range(len(self.coeffs) - 1, -1, -1):
            c = self.coeffs[i]
            if c == 0:
                continue
            if i == 0:
                terms.append(str(c))
            else:
                coef = "" if c == 1 else str(c)
                power = "x" if i == 1 else f"x^{i}"
                terms.append(coef + power)
        return " + ".join(terms)

    def __repr__(self):
        return f"Polynomial({self.coeffs})"

    def __len__(self):
        return len(self.coeffs)

    def __getitem__(self, i):
        return self.coeffs[i] if i < len(self.coeffs) else 0

    def __call__(self, x):
        return sum(c * x**i for i, c in enumerate(self.coeffs))

    def __add__(self, other):
        n = max(len(self), len(other))
        return Polynomial([self[i] + other[i] for i in range(n)])

    def __mul__(self, k):
        return Polynomial([c * k for c in self.coeffs])

    def degree(self):
        for i in range(len(self.coeffs) - 1, -1, -1):
            if self.coeffs[i] != 0:
                return i
        return 0

    def __eq__(self, other):
        return self.degree() == other.degree()

    def __lt__(self, other):
        return self.degree() < other.degree()           
