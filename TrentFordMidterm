def process_readings(in_file, json_file, alert_file, limit):
    stats = {}   # sensor_id: [count, total, max]
    alerts = []

    with open(in_file, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            timestamp, sensor_id, raw_value = line.split(",")
            value = float(raw_value)

            if sensor_id not in stats:
                stats[sensor_id] = [0, 0.0, value]
            s = stats[sensor_id]
            s[0] += 1
            s[1] += value
            s[2] = max(s[2], value)

            if value > limit:
                alerts.append(f"{timestamp} {sensor_id} {raw_value}")

    summary = {
        sid: {"count": n, "average": total / n, "max": mx}
        for sid, (n, total, mx) in stats.items()
    }
    with open(json_file, "w") as f:
        json.dump(summary, f, indent=2)

    with open(alert_file, "w") as f:
        for a in alerts:
            f.write(a + "\n")

    return len(alerts)

