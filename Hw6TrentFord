# Problem 3: Smart GradeBook with Operator Overloading
# ============================================================

class GradeBook:
    def __init__(self, course_name):
        self.course_name = course_name
        self.grades = {}

    # --- Display Methods ---

    def __str__(self):
        return f"GradeBook: {self.course_name} ({len(self.grades)} students)"

    def __repr__(self):
        return f"GradeBook('{self.course_name}')"

    # --- Container Protocol ---

    def __len__(self):
        return len(self.grades)

    def __getitem__(self, student):
        return self.grades[student]

    def __setitem__(self, student, grade):
        if not 0 <= grade <= 100:
            raise ValueError("Grade must be between 0 and 100")

        self.grades[student] = grade

    def __contains__(self, student):
        return student in self.grades

    def __iter__(self):
        return iter(self.grades)

    def __bool__(self):
        return bool(self.grades)

    # --- Property ---

    @property
    def average(self):
        if not self.grades:
            return 0.0

        return sum(self.grades.values()) / len(self.grades)

    # --- Arithmetic Operators ---

    def __add__(self, other):
        combined = GradeBook(f"{self.course_name} + {other.course_name}")

        for student, grade in self.grades.items():
            combined[student] = grade

        for student, grade in other.grades.items():
            if student in combined:
                combined[student] = max(combined[student], grade)
            else:
                combined[student] = grade

        return combined

    def __iadd__(self, other):
        for student, grade in other.grades.items():
            if student in self:
                self[student] = max(self[student], grade)
            else:
                self[student] = grade

        return self

    def __mul__(self, factor):
        curved = GradeBook(f"{self.course_name} (curved)")

        for student, grade in self.grades.items():
            new_grade = min(grade * factor, 100)
            curved[student] = new_grade

        return curved

    # --- Comparison Operators ---

    def __eq__(self, other):
        if not isinstance(other, GradeBook):
            return NotImplemented

        return abs(self.average - other.average) <= 0.01

    def __lt__(self, other):
        if not isinstance(other, GradeBook):
            return NotImplemented

        return self.average < other.average

    def __le__(self, other):
        if not isinstance(other, GradeBook):
            return NotImplemented

        return self.average <= other.average


